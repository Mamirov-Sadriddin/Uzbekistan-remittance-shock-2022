# 8. Pre-trend tests
cat("\n\n=== Pre-shock trend tests (11 leads) ===\n")
esc <- function(x) gsub("([.^$|?*+()\\[\\]])", "\\\\\\1", x)
pretrend <- function(d, y, g = "informal") {
  W <- d |> filter(event_time >= -12, event_time <= 18)
  r <- feols(as.formula(paste0(y, " ~ i(event_time, ", g, ", ref = -1) | hhid + round")),
             cluster = ~hhid, data = W)
  nm <- grep("event_time::-", names(coef(r)), value = TRUE)
  list(p = wald(r, keep = paste0("^", esc(nm), "$"), print = FALSE)$p, k = length(nm))
}
