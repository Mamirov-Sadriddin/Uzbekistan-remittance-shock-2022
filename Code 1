# 7. Romano-Wolf (Randomization Based)
cat("\nTable B.9: Romano-Wolf Correction\n")
rw_randomization <- function(h, outcomes, B = 2000) {
  dat <- h["hhid"]
  dat$round <- h$round
  dat$post <- h$post
  for (y in outcomes) {                        
    mm <- tapply(ifelse(h$post == 0, h[[y]], NA), h$month, mean, na.rm = TRUE)
    dat[[paste0(y, "_p")]] <- as.numeric(h[[y]] - mm[as.character(h$month)])
  }
  ids <- unique(dat$hhid)
  inf0 <- h$informal[match(ids, h$hhid)]
  
  tvec <- function(iv) {
    d <- dat
    d$ip <- iv[match(d$hhid, ids)] * d$post
    sapply(outcomes, function(y)
      coeftable(feols(as.formula(paste0(y, "_p ~ ip | hhid + round")),
                      data = d, cluster = ~hhid))["ip", "t value"])
  }
  
  obs  <- tvec(inf0)
  perm <- t(replicate(B, abs(tvec(sample(inf0)))))
  ord  <- order(-abs(obs))
  rw   <- setNames(numeric(length(obs)), names(obs))
  rem  <- ord
  prev <- 0
  
  for (k in ord) {
    p <- mean(apply(perm[, rem, drop = FALSE], 1, max) >= abs(obs[k]))
    rw[k] <- prev <- max(p, prev)
    rem <- setdiff(rem, k)
  }
  data.frame(outcome = names(obs), t = round(obs, 2), romano_wolf_p = round(rw, 3))
}

outs <- c("food_insuff", "reduced_food", "forgone_med", "unable_util", "water_disrupt")
print(rw_randomization(h, outs, B = 2000))
cat("Expected RW p: 0.000 / 0.021 / 0.012 / 0.925 / 0.183\n")


# 8. Pre-Trends
cat("\nPre-Shock Trend Tests (12 leads)\n")
pretrend <- function(h, y) {
  W <- h |> filter(event_time >= -12, event_time <= 18)
  r <- feols(as.formula(paste0(y, " ~ i(event_time, informal, ref = -1) | hhid + round")),
             cluster = ~hhid, data = W)
  nm <- grep("event_time::-", names(coef(r)), value = TRUE)
  wald(r, keep = paste0("^", gsub("([\\^\\$\\.\\|\\?\\*\\+\\(\\)\\[\\]])", "\\\\\\1", nm), "$"),
       print = FALSE)$p
}

