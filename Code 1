# Delta and the bias-adjusted coefficient
oster <- function(b0, b1, R0, R1, mult) {
  Rmax  <- min(mult * R1, 1)
  delta <- (b1 * (R1 - R0)) / ((b0 - b1) * (Rmax - R1))
  bstar <- b1 - (b0 - b1) * (Rmax - R1) / (R1 - R0)
  c(Rmax = Rmax, delta = delta, beta_adjusted = bstar)
}
res <- t(sapply(c(1.3, 2.0), function(k) oster(b0, b1, R0, R1, k)))
rownames(res) <- c("Rmax = 1.3 x R1", "Rmax = 2.0 x R1")
print(round(res, 3))

