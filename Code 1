# 16. Baseline window robustness (Table B.6)
cat("\n\n=== Table B.6: baseline window robustness ===\n")
run_window <- function(lo, hi) {
  W <- ind |> filter(round %in% lo:hi, !is.na(mig_living_country)) |>
    mutate(is_ru = as.integer(mig_living_country == 1))
  ru <- W |> group_by(hhid) |> summarise(r = mean(is_ru), .groups = "drop") |>
    filter(r > 0.5) |> pull(hhid)
  g <- W |> filter(is_ru == 1, mig_living_work_official %in% c(1, 2)) |>
    group_by(hhid) |>
    summarise(noff = sum(mig_living_work_official == 1),
              ninf = sum(mig_living_work_official == 2), .groups = "drop") |>
    filter(hhid %in% ru, noff != ninf) |>
    mutate(informal = as.integer(ninf > noff)) |> select(hhid, informal)
  hh <- pan |> inner_join(g, by = "hhid") |>
    mutate(inf_post = informal * post) |> haven::zap_labels()
  hh$remit_ihs <- asinh(pmin(hh$remit_usd, cap))
  hh <- deseason(hh, "food_insuff"); hh <- deseason(hh, "lifeline")
  rf <- feols(food_insuff_des ~ inf_post | hhid + round, cluster = ~hhid, data = hh)
  rl <- feols(lifeline_des ~ inf_post | hhid + round, cluster = ~hhid, data = hh)
  data.frame(window = sprintf("%d-%d (%d rounds)", lo, hi, hi - lo + 1),
             russia = length(ru),
             informal = sum(g$informal), formal = sum(g$informal == 0),
             food = round(coef(rf)["inf_post"], 3),
             food_se = round(se(rf)["inf_post"], 3),
             pretrend = round(pretrend(hh, "food_insuff_des")$p, 3),
             composite = round(coef(rl)["inf_post"], 3),
             comp_p = round(pvalue(rl)["inf_post"], 3))
}
