cat("\n\n=== Propensity score matching ===\n")
vars <- c("mean_age", "max_educ", "share_female", "hhsize_b", "food_insec")
Dm <- D[complete.cases(D[c("informal", vars)]), ]
Dm$ps <- predict(glm(reformulate(vars, "informal"), family = binomial, data = Dm),
                 type = "response")
trt <- Dm[Dm$informal == 1, ]; trt <- trt[order(-trt$ps), ]
ctl <- Dm[Dm$informal == 0, ]
avail <- rep(TRUE, nrow(ctl)); pairs <- list()
for (i in seq_len(nrow(trt))) {
  d <- abs(ctl$ps - trt$ps[i]); d[!avail] <- Inf
  j <- which.min(d)
  if (is.finite(d[j])) { avail[j] <- FALSE
    pairs[[length(pairs) + 1]] <- c(trt$hhid[i], ctl$hhid[j]) }
}
matched <- unlist(pairs)
hm <- h[h$hhid %in% matched, ]
hm <- deseason(hm, "food_insuff")
rm_ <- feols(food_insuff_des ~ inf_post | hhid + round, cluster = ~hhid, data = hm)
cat(sprintf("  %d matched pairs, %+.4f (%.4f)\n", length(pairs),
            coef(rm_)["inf_post"], se(rm_)["inf_post"]))

# 20. Observable confounders and Oster
cat("\n\n=== Observable confounders ===\n")
ho <- h |>
  left_join(select(D, hhid, max_educ, share_female, mean_age, unoff, hhsize_b, got_wage),
            by = "hhid") |>
  mutate(educ_p = max_educ * post, fem_p = share_female * post, agem_p = mean_age * post,
         unoff_p = unoff * post, hsz_p = hhsize_b * post, wage_p = got_wage * post) |>
  filter(!is.na(educ_p), !is.na(fem_p), !is.na(agem_p),
         !is.na(unoff_p), !is.na(hsz_p), !is.na(wage_p), !is.na(food_insuff_des))
ctrl <- list(
  none      = feols(food_insuff_des ~ inf_post | hhid + round, cluster = ~hhid, data = ho),
  channel   = feols(food_insuff_des ~ inf_post + unoff_p | hhid + round, cluster = ~hhid, data = ho),
  chan_educ = feols(food_insuff_des ~ inf_post + unoff_p + educ_p | hhid + round, cluster = ~hhid, data = ho),
  female    = feols(food_insuff_des ~ inf_post + fem_p | hhid + round, cluster = ~hhid, data = ho),
  wage      = feols(food_insuff_des ~ inf_post + wage_p | hhid + round, cluster = ~hhid, data = ho))
etable(ctrl)

cat(sprintf("\ncorrelation migration channel and formality: r = %.3f\n",
            cor(D$unoff, D$informal, use = "complete.obs")))
cat("\nwithin-channel comparison:\n")
hw <- ho[ho$unoff > 0.5, ]
hw <- deseason(hw, "food_insuff")
rw_ <- feols(food_insuff_des ~ inf_post | hhid + round, cluster = ~hhid, data = hw)
cat(sprintf("  informal %d, formal %d, %+.4f (%.4f)\n",
            n_distinct(hw$hhid[hw$informal == 1]), n_distinct(hw$hhid[hw$informal == 0]),
            coef(rw_)["inf_post"], se(rw_)["inf_post"]))

cat("\nOster (2019) sensitivity\n")
m_r <- lm(food_insuff_des ~ inf_post + factor(hhid) + factor(round), data = ho)
m_f <- lm(food_insuff_des ~ inf_post + educ_p + fem_p + agem_p +
            unoff_p + hsz_p + wage_p + factor(hhid) + factor(round), data = ho)
b0 <- coef(m_r)["inf_post"]; R0 <- summary(m_r)$r.squared
b1 <- coef(m_f)["inf_post"]; R1 <- summary(m_f)$r.squared
cat(sprintf("  restricted beta %+.4f  R2 %.4f\n  full       beta %+.4f  R2 %.4f\n",
            b0, R0, b1, R1))
oster <- function(b0, b1, R0, R1, mult) {
  Rmax <- min(mult * R1, 1)
  c(Rmax = Rmax,
    delta = (b1 * (R1 - R0)) / ((b0 - b1) * (Rmax - R1)),
    beta_adjusted = b1 - (b0 - b1) * (Rmax - R1) / (R1 - R0))
}
res <- t(sapply(c(1.3, 2.0), function(k) oster(b0, b1, R0, R1, k)))
rownames(res) <- c("Rmax = 1.3 x R1", "Rmax = 2.0 x R1")
print(round(res, 3))

