balance <- function(d, vars) {
  do.call(rbind, lapply(vars, function(v) {
    a <- d[[v]][d$informal == 1]
    b <- d[[v]][d$informal == 0]
    a <- a[is.finite(a)]
    b <- b[is.finite(b)]
    nd <- (mean(a) - mean(b)) / sqrt((var(a) + var(b)) / 2)
    data.frame(Variable = v, 
               Informal = round(mean(a), 3), 
               Formal = round(mean(b), 3),
               Diff = round(mean(a) - mean(b), 3), 
               Norm_diff = round(nd, 3),
               p = round(t.test(a, b)$p.value, 3),
               Imbalance = ifelse(abs(nd) > 0.25, "*", ""))
  }))
}

