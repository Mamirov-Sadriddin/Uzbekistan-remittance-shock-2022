# 11. Permutation test
cat("\n\n=== Permutation test ===\n")
perm_test <- function(h, y, B = 2000) {
  ids  <- unique(h$hhid)
  inf0 <- h$informal[match(ids, h$hhid)]
  d    <- data.frame(yv = h[[y]], hhid = h$hhid, round = h$round, post = h$post)
  d$ip <- inf0[match(d$hhid, ids)] * d$post
  obs  <- coef(feols(yv ~ ip | hhid + round, data = d))["ip"]
  null <- replicate(B, {
    d$ip <- sample(inf0)[match(d$hhid, ids)] * d$post
    coef(feols(yv ~ ip | hhid + round, data = d))["ip"]
  })
  c(observed = unname(obs), perm_p = mean(abs(null) >= abs(obs)),
    null_mean = mean(null), null_sd = sd(null))
}
