# 3. De-seasonalization
# Subtract the pre-shock group x calendar-month mean.
deseason <- function(d, y, grp = "informal") {
  key  <- interaction(d[[grp]], d$month, drop = TRUE)
  seas <- tapply(ifelse(d$post == 0, d[[y]], NA), key, mean, na.rm = TRUE)
  d[[paste0(y, "_des")]] <- as.numeric(d[[y]] - seas[as.character(key)])
  d
}

